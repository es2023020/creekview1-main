# ─── Supabase (required for contact / lead form) ───
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# ─── Site URL (required for SEO, sitemap, Open Graph) ───
# Local: http://localhost:5173
# Production: https://your-domain.vercel.app
VITE_SITE_URL=http://localhost:5173

# ─── Analytics (optional) ───
# Vercel Web Analytics & Speed Insights work automatically on Vercel when enabled in project settings.
# Optional Google Analytics 4:
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Server-only (optional — admin / SSR; not needed for public lead form) ───
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
